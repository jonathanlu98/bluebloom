    },
    "Click Allow in the system prompt so Blue Bloom can reach your headphones.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke in der Systemabfrage auf „Erlauben“, damit Blue Bloom deine Kopfhörer erreicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en Permitir en el aviso del sistema para que Blue Bloom pueda conectarse a tus auriculares."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur Autoriser dans la fenêtre du système pour que Blue Bloom puisse joindre votre casque."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムのダイアログで「許可」をクリックすると、Blue Bloom がヘッドフォンに接続できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 대화상자에서 ‘허용’을 클릭해야 Blue Bloom이 헤드폰에 연결할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在系统弹窗中点按“允许”，Blue Bloom 才能连接耳机。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在系統提示中按一下「允許」，Blue Bloom 才能連接耳機。"
          }
        }
      }
    },
    "Click a device below, or add new headphones.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke unten auf ein Gerät oder füge neue Kopfhörer hinzu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en un dispositivo o añade unos auriculares nuevos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur un appareil ci-dessous ou ajoutez un nouveau casque."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下のデバイスをクリックするか、新しいヘッドフォンを追加します。"
