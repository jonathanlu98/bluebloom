    "Turn Blue Bloom on or off. When off, macOS handles your headphones.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blue Bloom ein- oder ausschalten. Wenn aus, verwaltet macOS deine Kopfhörer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa o desactiva Blue Bloom. Si está desactivado, macOS gestiona tus auriculares."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez ou désactivez Blue Bloom. Désactivé, macOS gère votre casque."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Blue Bloom をオン／オフにします。オフのときはヘッドフォンを macOS が処理します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Blue Bloom을 켜거나 끕니다. 끄면 macOS가 헤드폰을 처리합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开或关闭 Blue Bloom。关闭后由 macOS 连接耳机。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開啟或關閉 Blue Bloom。關閉後由 macOS 連線耳機。"
          }
        }
      }
    },
    "Turn on Blue Bloom in Privacy & Security › Bluetooth, then reopen it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere Blue Bloom unter „Datenschutz & Sicherheit › Bluetooth“ und öffne es dann erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa Blue Bloom en Privacidad y seguridad › Bluetooth y vuelve a abrirlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez Blue Bloom dans Confidentialité et sécurité › Bluetooth, puis rouvrez-le."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「プライバシーとセキュリティ › Bluetooth」で Blue Bloom をオンにしてから、もう一度開いてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘개인정보 보호 및 보안 › Bluetooth’에서 Blue Bloom을 켠 다음 다시 여십시오."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“隐私与安全性 › 蓝牙”中打开 Blue Bloom，然后重新打开它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在「隱私權與安全性 › 藍牙」中開啟 Blue Bloom，然後重新打開它。"
          }
        }
      }
