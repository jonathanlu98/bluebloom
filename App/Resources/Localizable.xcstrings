    "Apps play into it and Blue Bloom streams it to your headphones. Requires an administrator password.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps spielen hinein, Blue Bloom streamt es an deine Kopfhörer. Erfordert ein Administratorpasswort."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las apps reproducen ahí y Blue Bloom lo transmite a tus auriculares. Requiere una contraseña de administrador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les apps y diffusent leur son et Blue Bloom l’envoie à votre casque. Nécessite un mot de passe administrateur."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "App のサウンドがここに送られ、Blue Bloom がヘッドフォンにストリーミングします。管理者パスワードが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 사운드가 여기로 재생되고 Blue Bloom이 헤드폰으로 스트리밍합니다. 관리자 암호가 필요합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "App 把声音播放到这里，再由 Blue Bloom 推送到耳机。需要管理员密码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App 把聲音播放到這裡，再由 Blue Bloom 串流到耳機。需要管理者密碼。"
          }
        }
      }
    },
