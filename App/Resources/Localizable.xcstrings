    "Before you start, here's what Blue Bloom does on your Mac.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bevor du loslegst: Das macht Blue Bloom auf deinem Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de empezar, esto es lo que Blue Bloom hace en tu Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avant de commencer, voici ce que Blue Bloom fait sur votre Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "始める前に、Blue Bloom がこの Mac で何をするかを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시작하기 전에 Blue Bloom이 Mac에서 하는 일을 확인하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始之前，先了解 Blue Bloom 会在你的 Mac 上做什么。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "開始之前，先了解 Blue Bloom 會在你的 Mac 上做什麼。"
          }
        }
      }
    },
    "Bitrate": {
      "localizations": {
        "de": {
