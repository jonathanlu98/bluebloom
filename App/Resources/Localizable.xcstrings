    "To remove it completely, use Uninstall Blue Bloom in Settings › Advanced.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum vollständigen Entfernen nutze „Blue Bloom deinstallieren“ unter „Einstellungen › Erweitert“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para eliminarlo por completo, usa Desinstalar Blue Bloom en Ajustes › Avanzado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour le supprimer complètement, utilisez Désinstaller Blue Bloom dans Réglages › Avancé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完全に削除するには、「設定 › 詳細」の「Blue Bloom をアンインストール」を使います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완전히 제거하려면 ‘설정 › 고급’의 ‘Blue Bloom 제거’를 사용하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要彻底移除，请使用“设置 › 高级”中的“卸载 Blue Bloom”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要完全移除，請使用「設定 › 進階」中的「解除安裝 Blue Bloom」。"
          }
        }
      }
    },
