    "Spends bits where the music needs them, never above the limit.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verteilt die Bits dorthin, wo die Musik sie braucht – nie über dem Limit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa los bits donde la música los necesita, sin superar el límite."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dépense les bits là où la musique en a besoin, sans jamais dépasser la limite."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音楽が必要とする部分にビットを割り当て、上限は超えません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음악에 필요한 곳에 비트를 쓰며 한도를 넘지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把码率花在音乐需要的地方，但绝不超过上限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把位元率用在音樂需要的地方，但絕不超過上限。"
          }
        }
      }
    },
