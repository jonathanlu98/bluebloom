{
  "sourceLanguage": "en",
  "strings": {
    "": {},
    "%@ doesn't support %@, so macOS resamples to %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ unterstützt %@ nicht, daher rechnet macOS auf %@ um."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ doesn't support %2$@, so macOS resamples to %3$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no admite %@, así que macOS remuestrea a %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ne prend pas en charge %@, macOS rééchantillonne donc à %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は %@ に対応していないため、macOS が %@ にリサンプリングします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@은(는) %@을(를) 지원하지 않아 macOS가 %@(으)로 리샘플링합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 不支持 %@，由 macOS 重采样到 %@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 不支援 %@，由 macOS 重新取樣到 %@。"
          }
        }
      }
    },
    "%@ doesn't support %@; macOS resamples the source to this rate.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ unterstützt %@ nicht; macOS rechnet die Quelle auf diese Rate um."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ doesn't support %2$@; macOS resamples the source to this rate."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no admite %@; macOS remuestrea la fuente a este valor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ne prend pas en charge %@ ; macOS rééchantillonne la source à cette valeur."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は %@ に対応していないため、macOS が音源をこのレートにリサンプリングします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@은(는) %@을(를) 지원하지 않아 macOS가 음원을 이 샘플률로 리샘플링합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 不支持 %@，由 macOS 将音源重采样到这个采样率。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 不支援 %@，由 macOS 將音源重新取樣到這個取樣率。"
          }
        }
      }
    },
    "%@ doesn't support this sample rate": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ unterstützt diese Abtastrate nicht"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no admite esta frecuencia de muestreo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ne prend pas en charge cette fréquence d’échantillonnage"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ はこのサンプルレートに対応していません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@은(는) 이 샘플률을 지원하지 않습니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 不支持此采样率"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 不支援此取樣率"
          }
        }
      }
    },
    "%@ encoder couldn't start": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der %@-Encoder konnte nicht starten"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo iniciar el codificador %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’encodeur %@ n’a pas pu démarrer"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ エンコーダを起動できませんでした"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 인코더를 시작할 수 없습니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 编码器无法启动"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 編碼器無法啟動"
          }
        }
      }
    },
    "%@ is in use by another device": {
      "localizations": {
        "de": {
          "stringUnit": {
