            "state": "translated",
            "value": "左耳"
          }
        }
      }
    },
    "Limited by Maximum sample rate, so macOS resamples to %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Durch „Maximale Abtastrate“ begrenzt, daher rechnet macOS auf %@ um."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Limitado por «Frecuencia de muestreo máxima», así que macOS remuestrea a %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Limité par « Fréquence d’échantillonnage maximale », macOS rééchantillonne donc à %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「最大サンプルレート」の設定により、macOS が %@ にリサンプリングします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "「최대 샘플률」 설정으로 macOS가 %@(으)로 리샘플링합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "受「最高采样率」设置限制，由 macOS 重采样到 %@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "受「最高取樣率」設定限制，由 macOS 重新取樣到 %@。"
          }
        }
      }
    },
    "Limited by Maximum sample rate; macOS resamples the source to this rate.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Durch „Maximale Abtastrate“ begrenzt; macOS rechnet die Quelle auf diese Rate um."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Limitado por «Frecuencia de muestreo máxima»; macOS remuestrea la fuente a este valor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Limité par « Fréquence d’échantillonnage maximale » ; macOS rééchantillonne la source à cette valeur."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「最大サンプルレート」の設定による制限です。macOS が音源をこのレートにリサンプリングします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "「최대 샘플률」 설정으로 제한되어 macOS가 음원을 이 샘플률로 리샘플링합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "受「最高采样率」设置限制，由 macOS 将音源重采样到这个采样率。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "受「最高取樣率」設定限制，由 macOS 將音源重新取樣到這個取樣率。"
          }
        }
      }
    },
    "Looking for nearby devices…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Suche nach Geräten in der Nähe …"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Buscando dispositivos cercanos…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recherche d’appareils à proximité…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "近くのデバイスを探しています…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주변 기기를 찾는 중…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在查找附近的设备…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在尋找附近的裝置⋯"
          }
        }
      }
    },
    "Lowers the bitrate when the link gets congested, then climbs back, never above the setting above.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Senkt die Bitrate bei überlasteter Verbindung und erhöht sie danach wieder, nie über die Einstellung oben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Baja la tasa de bits cuando el enlace se congestiona y luego la vuelve a subir, nunca por encima del ajuste de arriba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réduit le débit quand la liaison est encombrée, puis le remonte, sans jamais dépasser le réglage ci-dessus."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続が混雑するとビットレートを下げ、その後徐々に戻します。上の設定を超えることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결이 혼잡하면 비트레이트를 낮췄다가 다시 올립니다. 위의 설정보다 높아지지 않습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "链路拥堵时降低码率，之后再逐步回升，最高不超过上面的设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連線擁塞時降低位元率，之後再逐步回升，最高不超過上方的設定。"
          }
        }
      }
    },
