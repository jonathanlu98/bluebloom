    "Adaptive lowers the bitrate when the link gets congested, then climbs back.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Adaptiv“ senkt die Bitrate, wenn die Verbindung überlastet ist, und erhöht sie danach wieder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modo adaptativo reduce la tasa de bits cuando el enlace se congestiona y luego la recupera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mode adaptatif réduit le débit quand la liaison est encombrée, puis le rétablit."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "適応は、接続が混雑するとビットレートを下げ、回復すると元に戻します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "적응형은 연결이 혼잡하면 비트 전송률을 낮추고 이후 다시 올립니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自适应会在连接拥堵时降低码率，之后再逐步回升。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自適應會在連線壅塞時降低位元率，之後再逐步回升。"
          }
        }
      }
    },
