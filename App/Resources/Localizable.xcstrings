    "Use Blue Bloom while streaming, and go back to the previous output when the headphones disconnect.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Streamen Blue Bloom verwenden und nach dem Trennen der Kopfhörer zur vorherigen Ausgabe zurückkehren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa Blue Bloom mientras transmites y vuelve a la salida anterior cuando se desconectan los auriculares."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utiliser Blue Bloom pendant la diffusion et revenir à la sortie précédente quand le casque se déconnecte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ストリーミング中は Blue Bloom を使い、ヘッドフォンの接続が切れたら元の出力に戻します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스트리밍하는 동안 Blue Bloom을 사용하고, 헤드폰 연결이 끊기면 이전 출력으로 돌아갑니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "推流时使用 Blue Bloom，耳机断开后切回原来的输出。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "串流時使用 Blue Bloom，耳機中斷連線後切回原本的輸出。"
          }
        }
      }
    },
